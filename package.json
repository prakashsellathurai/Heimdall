{
  "name": "heimdall",
  "version": "1.3.1",
  "description": "All-seeing content Curator - Hacker News browser extension",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && bun run scripts/package.ts",
    "test": "bun test --isolate --path-ignore-patterns 'tests/e2e/*'",
    "test:watch": "bun test --isolate --watch tests/",
    "test:coverage": "bun test --isolate --coverage --path-ignore-patterns tests/e2e/*.spec.ts tests/",
    "test:e2e": "vite build && bun run playwright test",
    "test:all": "vite build && bun test --isolate --path-ignore-patterns 'tests/e2e/*' && bun run playwright test",
    "benchmark": "bun run benchmarks/core.bench.ts --expose-gc",
    "bump-version": "bun run scripts/bump-version.ts",
    "create-demo-video": "bun run scripts/create-demo-video.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/browser-chromium": "^1.57.0",
    "@playwright/test": "^1.57.0",
    "archiver": "^8.0.0",
    "chrome-types": "^0.1.429",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@mitata/counters": "^0.0.8",
    "mitata": "^1.0.34"
  }
}
