{
    "name": "heimdall",
    "version": "1.2.0",
    "description": "All-seeing content Curator - Hacker News browser extension",
    "private": true,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && bun run scripts/package.ts",
        "test": "bun test --isolate --path-ignore-patterns 'tests/e2e/*'",
        "test:watch": "bun test --isolate --watch tests/",
        "test:coverage": "bun test --isolate --coverage --path-ignore-patterns tests/e2e/* tests/",
        "test:e2e": "vite build && bun run playwright test",
        "benchmark": "bun run benchmarks/core.bench.mjs --expose-gc",
        "create-demo-video": "bun run scripts/create-demo-video.ts"
    },
    "devDependencies": {
        "@playwright/browser-chromium": "^1.57.0",
        "@playwright/test": "^1.57.0",
        "archiver": "^8.0.0",
        "chrome-types": "^0.1.429",
        "jsdom": "^27.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14"
    },
    "dependencies": {
        "@mitata/counters": "^0.0.8",
        "mitata": "^1.0.34"
    }
}
